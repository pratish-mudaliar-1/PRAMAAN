# .env.example — Copy to .env and fill in real values.
# NEVER commit .env with real secrets.

PRAMAAN_ENVIRONMENT=development
PRAMAAN_DEBUG=true
PRAMAAN_CORS_ORIGINS=["http://localhost:3000"]

# ── Database ───────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pramaan
DB_USER=pramaan
DB_PASSWORD=pramaan

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── S3 / MinIO ─────────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_EVIDENCE=pramaan-evidence

# ── Auth ───────────────────────────────────────────────────────────────────────
AUTH_OIDC_ISSUER=http://localhost:8000/dev-oidc
AUTH_JWKS_URL=
AUTH_JWT_AUDIENCE=pramaan-api
# Used ONLY in development; remove or leave empty in production
AUTH_DEV_JWT_SECRET=dev-only-secret-change-in-prod

# ── Observability ──────────────────────────────────────────────────────────────
OTEL_LOG_LEVEL=INFO
OTEL_OTLP_ENDPOINT=
