# .env.docker — Used by docker-compose services
# DB_HOST/REDIS_HOST use container names, not localhost

PRAMAAN_ENVIRONMENT=development
PRAMAAN_DEBUG=false

DB_HOST=postgres
DB_PORT=5432
DB_NAME=pramaan
DB_USER=pramaan
DB_PASSWORD=pramaan

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_EVIDENCE=pramaan-evidence

AUTH_OIDC_ISSUER=http://api:8000/dev-oidc
AUTH_JWKS_URL=
AUTH_JWT_AUDIENCE=pramaan-api
AUTH_DEV_JWT_SECRET=dev-only-secret-change-in-prod

OTEL_LOG_LEVEL=INFO
